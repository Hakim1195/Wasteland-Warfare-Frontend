[gd_resource type="AudioBusLayout" format=3]

; Disposition de bus audio (Feuille de route R5) — séparation Master / Musique / SFX
; pour que l'écran Options puisse régler chaque volume indépendamment. Musique et SFX
; sont routés vers Master (volume général). Aucune source audio n'existe encore (R6),
; mais la structure est prête : tout son futur n'aura qu'à viser le bus "Music" ou "SFX".

[resource]
bus/0/name = &"Master"
bus/0/solo = false
bus/0/mute = false
bus/0/bypass_fx = false
bus/0/volume_db = 0.0
bus/0/send = &"Master"
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/2/name = &"SFX"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"
; Bus AMBIANCE (§8.122, LOT C) — boucles diégétiques (Geiger, vent, radio du QG). Séparé des SFX
; pour deux raisons : (1) ce sont des boucles CONTINUES, pas des ponctuations — les couper avec les
; SFX rendrait le monde muet ; (2) leur dosage est un goût personnel (certains veulent le Geiger
; fort, d'autres l'éteindre) → son propre slider dans Paramètres.
; -12 dB au repos = « présent mais discret » (décision Hakim 2026-07-27). Cette valeur n'est le
; niveau effectif QUE si SettingsManager n'a pas encore appliqué le sien (il écrase le volume du
; bus au démarrage) — le défaut jumeau côté réglages vaut 0,25 linéaire, soit exactement -12 dB.
bus/3/name = &"Ambience"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = -12.0
bus/3/send = &"Master"
