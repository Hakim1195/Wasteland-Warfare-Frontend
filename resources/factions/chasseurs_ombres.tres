[gd_resource type="Resource" script_class="FactionData" format=3]

[ext_resource type="Script" path="res://resources/factions/faction_data.gd" id="1_fd"]

[resource]
script = ExtResource("1_fd")
id = "chasseurs_ombres"
name = "Les Chasseurs d'Ombres"
description = "Réseau d'espions et d'assassins qui vendent l'information au prix du sang. Avant même le premier coup de feu, ils savent déjà ce que leurs rivaux convoitent en secret.

[b]Pouvoir :[/b] regardent secrètement l'objectif d'un joueur ciblé au début de la partie."
modifiers = {
"peek_objective": 1
}
hero_path = "res://assets/images/heroes/chasseurs_ombres.png"
hero_model_path = "res://assets/models/chasseurs_ombres.glb"
accent_color = Color(0.25098, 0.25098, 0.4, 1)
