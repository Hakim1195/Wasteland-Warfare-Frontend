[resource]
script = ExtResource("1_fd")
id = "culte_isotope"
name = "Les Rad-Hunters"
description = "Fanatiques de l'isotope qui ont appris à respirer la mort lente. Le rayonnement qui décime les armées n'est pour eux qu'une bénédiction à orienter sur leurs propres bastions.

[b]Pouvoir :[/b] immunise 1 territoire allié de son choix contre la zone radioactive à chaque tour."
modifiers = {
"free_contamination_immunity": 1
}
